<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-test for AnyUnit.Runner.Bootstrap: unlike every other self-test
    assembly in this repo (a plain library, discovered externally by
    pointing anyunit-runner/anyunit-browser-wasm at its .dll), this one is
    the actual, real thing AnyUnit.Runner.Bootstrap is for - a runnable
    Exe whose own Main calls Runner.Run directly, discovering and running
    the [Test]s compiled into this SAME assembly. Same AnyUnit core
    [TestFixture]/[Test] attributes BasicTests uses (no style package
    needed) - Runner.Bootstrap itself has no opinion on which style a
    consumer uses.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\Runner\Bootstrap\AnyUnit.Runner.Bootstrap.csproj" />
  </ItemGroup>

</Project>
