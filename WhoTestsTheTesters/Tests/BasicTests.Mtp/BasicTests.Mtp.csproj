<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately a SEPARATE project from BasicTests.csproj, rather than
    multi-targeting BasicTests itself to add net10.0+Exe+MTP alongside its
    existing netstandard2.0 library target: BasicTests.csproj is also
    ProjectReference'd by Runner/Platforms/browser (a browser-wasm Blazor
    app) and WhoTestsTheTesters/RoughRunner, and Microsoft.Testing.Platform's
    dependency graph hasn't been verified as browser-wasm-safe. Keeping
    this as its own project means BasicTests.csproj itself is completely
    unmodified - zero risk to anything that already references it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasicTests\BasicTests.csproj" />
    <ProjectReference Include="..\..\..\Contrib\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

</Project>
