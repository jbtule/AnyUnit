<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate project/folder (own default obj/bin, no collision risk with
    BasicTests.csproj), but compiles BasicTests.csproj's own source
    directly via an explicit cross-folder Compile Include - not a
    ProjectReference to it. That means the actual [Test]-attributed
    classes live directly in THIS assembly too, so
    anyunit-runner/anyunit-net48-*/anyunit-browser-wasm can point straight at
    BasicTests.dll (this project's own output - see AssemblyName below) and find real tests, not just the MTP entry point
    (confirmed: pointing a runner at an earlier ProjectReference-based
    satellite shape found 0 tests, since the actual test classes only
    ever lived in the separately-referenced BasicTests.dll).

    This also sidesteps the reason a ProjectReference-based satellite
    couldn't just enable EnableAnyUnitRunner on BasicTests.csproj itself:
    BasicTests.csproj is ProjectReference'd by WhoTestsTheTesters/RoughRunner
    (non-self-contained), and a self-contained MTP executable can't
    ProjectReference a non-self-contained one (NETSDK1150, confirmed by
    hitting it) - with no ProjectReference between the two projects at
    all, that conflict can't arise.

    No <AnyUnitTestAssembly> override needed either: with none set, the
    generated Main defaults to testing its own entry assembly - exactly
    right now that the real test classes are compiled directly into it.
  -->
  <PropertyGroup>
    <!--
      Deliberately drops the ".Mtp". This project compiles the payload
      project's own sources (see above), so its tests ARE that suite -
      but AnyUnit keys an assembly by name (AssemblyMeta.UniqueName is
      "A:" + FullName), so as "BasicTests.Mtp" a merged results file forks at
      the assembly level and the same test shows up twice, each with one
      platform column, instead of once with a column per platform. The
      platform id already carries the real distinction (this leg reports
      "-mtp"), and run-mtp-tests.sh still writes /tmp/BasicTests.Mtp-*.json,
      so the two legs' artifacts don't collide.
    -->
    <AssemblyName>BasicTests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <!--
    Native AOT opt-in for build.yml's test-aot-mtp job:
    `dotnet publish -p:AnyUnitPublishAot=true -r <rid>`. Not a plain
    -p:PublishAot=true on the command line: a global property flows into
    every ProjectReference too, and AnyUnit/AnyUnit.TestingPlatform are
    netstandard2.0, which fails the publish outright with NETSDK1207
    ("Ahead-of-time compilation is not supported for the target
    framework") before ILC ever runs. Scoped here, PublishAot only ever
    applies to this executable, which is the only place it means anything.
    Nothing else about the project changes for a plain build.
  -->
  <PropertyGroup Condition="'$(AnyUnitPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <Compile Include="..\BasicTests\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <!--
    Opts this self-test project into real "report-trx" flag coverage
    (see build.yml's own "Run BasicTests.Mtp with report-trx" step) -
    AnyUnit.TestingPlatform itself only references the small Abstractions
    package (see its own csproj comment) and picks this up via reflection
    at runtime if present, exactly like a real consumer wanting TRX
    output would. Version pinned to 2.0.0 to match Microsoft.Testing.
    Platform's own pin (see AnyUnit.TestingPlatform.csproj) - a newer
    version here would be a NuGet package-downgrade error the same way
    bumping Microsoft.Testing.Platform alone was.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.0" />
  </ItemGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
