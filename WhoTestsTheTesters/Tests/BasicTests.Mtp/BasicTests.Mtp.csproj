<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately a SEPARATE project from BasicTests.csproj, rather than
    multi-targeting BasicTests itself to add net10.0+Exe+MTP alongside its
    existing netstandard2.0 library target: BasicTests.csproj is also
    ProjectReference'd by Runner/Platforms/browser (a self-contained
    browser-wasm Blazor app) and WhoTestsTheTesters/RoughRunner, and a
    self-contained executable cannot reference a non-self-contained one
    (NETSDK1150) - confirmed by actually trying it. Keeping this as its own
    project means BasicTests.csproj itself is completely unmodified - zero
    risk to anything that already references it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\BasicTests\BasicTests.csproj" />
    <ProjectReference Include="..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project only ProjectReferences the real test assembly, so the
         generated entry point needs to be told which assembly to test
         rather than defaulting to its own entry assembly. -->
    <AnyUnitTestAssembly Include="BasicTests" />
  </ItemGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
