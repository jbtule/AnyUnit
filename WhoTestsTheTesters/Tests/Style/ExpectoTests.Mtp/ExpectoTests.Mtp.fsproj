<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-shaped, like FSharpTests.Mtp: ExpectoTests.fsproj stays a plain
    library and is named here by simple assembly name via
    AnyUnitTestAssembly, rather than having its sources compiled in.
    That also means the assembly AnyUnit discovers IS "ExpectoTests", so
    this leg's results merge with the console runner's in a combined
    report instead of forking onto a second assembly name - see any
    Compile-Include .Mtp csproj for the other half of that story.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <!-- Native AOT opt-in for build.yml's test-aot-mtp job - see
       BasicTests.Mtp.csproj's own copy of this for why not a global
       PublishAot. FSharp.Core's own trim/AOT analysis summary codes are
       NoWarn'd, as in FsUnitTests.Mtp. -->
  <PropertyGroup Condition="'$(AnyUnitPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\ExpectoTests\AnyUnit.Style.ExpectoTests.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AnyUnitTestAssembly Include="ExpectoTests" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
