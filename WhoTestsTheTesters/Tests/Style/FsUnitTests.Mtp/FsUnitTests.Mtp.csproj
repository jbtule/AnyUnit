<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stays a separate satellite (ProjectReference, not colocated the way
    BasicTests.Mtp/ConstraintsTests.Mtp/NunitTests.Mtp/XunitTests.Mtp
    now are - see BasicTests.Mtp.csproj's own comment for that shape):
    FsUnitTests.fsproj's source is F# (.fs files), but the generated MTP
    entry point AnyUnit.TestingPlatform.targets writes is a C# (.g.cs)
    file added via <Compile Include> - fine for a .csproj, but an
    .fsproj uses the F# compiler, which can't compile a .cs file at all.
    Colocating would mean either this project becoming an .fsproj (so it
    globs the shared .fs source), which breaks the generated entry point,
    or staying a .csproj (so the entry point still compiles), which
    means the C# SDK's default globbing never picks up FsUnit.fs's F#
    source in the first place. Either way the actual [Test]-attributed
    classes can't end up compiled directly into this assembly - so
    anyunit-runner/anyunit-net48-*/anyunit-browser-wasm still can't point
    straight at FsUnitTests.Mtp.dll and find real tests; point them at
    FsUnitTests.dll (which this project's own ProjectReference flattens
    into its output directory anyway) instead. `dotnet test` and
    `dotnet run` on this project itself are unaffected by any of this -
    the Assembly.Load("FsUnitTests") indirection this satellite shape
    relies on works exactly the same regardless.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <!-- Native AOT opt-in for build.yml's test-aot-mtp job - see
       BasicTests.Mtp.csproj's own copy of this for why not a global
       PublishAot. -->
  <PropertyGroup Condition="'$(AnyUnitPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\FsUnitTests\FsUnitTests.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AnyUnitTestAssembly Include="FsUnitTests" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
