<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Same shape as FSharpTests.Mtp's own fsproj - see that file's comment
    for why this is a plain EnableAnyUnitRunner .fsproj now, no
    hand-written Program.fs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\ComboTests.FSharp\ComboTests.FSharp.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AnyUnitTestAssembly Include="ComboTests.FSharp" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
