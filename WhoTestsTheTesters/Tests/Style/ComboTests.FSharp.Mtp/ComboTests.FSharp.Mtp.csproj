<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate satellite (ProjectReference), same reasoning as
    FSharpTests.Mtp.csproj's own comment: ComboTests.FSharp.fsproj's
    source is F# (.fs files), but the generated MTP entry point
    AnyUnit.TestingPlatform.targets writes is a C# (.g.cs) file added
    via <Compile Include> - fine for a .csproj, but an .fsproj uses the
    F# compiler, which can't compile a .cs file at all.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\ComboTests.FSharp\ComboTests.FSharp.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AnyUnitTestAssembly Include="ComboTests.FSharp" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
