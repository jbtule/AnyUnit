<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately the ONE project that references BOTH AnyUnit.Style.Xunit
    and AnyUnit.Style.Nunit - it exists specifically to exercise the
    shared IRowInlineParameter/IGeneratingParameter/IArgParameter
    interfaces (AnyUnit.Run.Attributes) working across those two styles
    at once. XunitTests/NunitTests each stay single-style so their own
    unit tests aren't muddied by cross-style plumbing.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\..\Contrib\AnyUnit.Style.Xunit\AnyUnit.Style.Xunit.csproj" />
    <ProjectReference Include="..\..\..\..\Contrib\AnyUnit.Style.Nunit\AnyUnit.Style.Nunit.csproj" />
  </ItemGroup>

</Project>
