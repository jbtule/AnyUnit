<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate project/folder, same reasoning as BasicTests.Mtp.csproj:
    compiles XunitTests.csproj's own source directly via an explicit
    cross-folder Compile Include - not a ProjectReference to it - so
    the real [Test]-attributed classes live directly in this assembly
    too.
  -->
  <PropertyGroup>
    <!--
      Deliberately drops the ".Mtp". This project compiles the payload
      project's own sources (see above), so its tests ARE that suite -
      but AnyUnit keys an assembly by name (AssemblyMeta.UniqueName is
      "A:" + FullName), so as "XunitTests.Mtp" a merged results file forks at
      the assembly level and the same test shows up twice, each with one
      platform column, instead of once with a column per platform. The
      platform id already carries the real distinction (this leg reports
      "-mtp"), and run-mtp-tests.sh still writes /tmp/XunitTests.Mtp-*.json,
      so the two legs' artifacts don't collide.
    -->
    <AssemblyName>XunitTests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <!-- Native AOT opt-in for build.yml's test-aot-mtp job - see
       BasicTests.Mtp.csproj's own copy of this for why not a global
       PublishAot. -->
  <PropertyGroup Condition="'$(AnyUnitPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <Compile Include="..\XunitTests\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\..\Contrib\AnyUnit.Style.Xunit\AnyUnit.Style.Xunit.csproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
