<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Real F# MTP host now (was a C# satellite shell working around
    EnableAnyUnitRunner's own C#-only codegen) - see Program.fs's own
    comment. FSharpTests.fsproj itself stays a plain library, referenced
    here by simple assembly name via Assembly.Load, same as before.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpTests\FSharpTests.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

</Project>
