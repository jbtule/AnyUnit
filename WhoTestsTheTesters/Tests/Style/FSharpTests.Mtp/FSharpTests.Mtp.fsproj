<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A real .fsproj using EnableAnyUnitRunner directly, no hand-written
    Program.fs - Microsoft.Testing.Platform.MSBuild's own official
    entry-point generator genuinely emits real F# source (verified
    directly), so there's nothing C#-specific left to work around here.
    FSharpTests.fsproj itself stays a plain library, referenced by simple
    assembly name via AnyUnitTestAssembly below (see AnyUnit.TestingPlatform.
    targets/TestingPlatformBuilderHook.cs for how that reaches the test
    framework with no per-project generated code).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <!-- Native AOT opt-in for build.yml's test-aot-mtp job - see
       BasicTests.Mtp.csproj's own copy of this for why not a global
       PublishAot. FSharp.Core's own trim/AOT analysis summary codes are
       NoWarn'd, as in FsUnitTests.Mtp. -->
  <PropertyGroup Condition="'$(AnyUnitPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <ProjectReference Include="..\FSharpTests\FSharpTests.fsproj" />
    <ProjectReference Include="..\..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AnyUnitTestAssembly Include="FSharpTests" />
  </ItemGroup>

  <Import Project="..\..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
