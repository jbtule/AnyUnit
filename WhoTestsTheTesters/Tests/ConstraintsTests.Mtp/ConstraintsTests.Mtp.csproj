<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate project/folder, same reasoning as BasicTests.Mtp.csproj:
    compiles ConstraintsTests.csproj's own source directly via an
    explicit cross-folder Compile Include - not a ProjectReference to
    it - so the real [Test]-attributed classes live directly in this
    assembly too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.props" />

  <ItemGroup>
    <Compile Include="..\ConstraintsTests\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\Contrib\AnyUnit.Constraints\AnyUnit.Constraints.csproj" />
    <ProjectReference Include="..\..\..\AnyUnit.TestingPlatform\AnyUnit.TestingPlatform.csproj" />
  </ItemGroup>

  <Import Project="..\..\..\AnyUnit.TestingPlatform\build\AnyUnit.TestingPlatform.targets" />

</Project>
