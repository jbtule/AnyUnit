<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Razor Class Library, not an app: this ships the reusable
    AnyUnitRunnerPage component (results table, log, and headless-scrape
    hooks) for any Blazor WebAssembly host to drop in. Blazor components
    need the actual ASP.NET Core Components APIs, which only exist for
    "net" TFMs (not netstandard2.0, unlike AnyUnit's own core libraries).

    Runner/Platforms/wasm-runner-host is this repo's own consumer: a
    thin host app (Program.cs/App.razor/wwwroot/index.html) that
    references this package and dynamically loads whatever test
    assemblies anyunit-wasm points it at over HTTP - exactly the same
    library/satellite split used for AnyUnit.TestingPlatform +
    BasicTests.Mtp.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>Reusable Blazor WebAssembly results-page component for running AnyUnit tests in the browser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnyUnit\AnyUnit.csproj" />
  </ItemGroup>

</Project>
