<Project>

  <!--
    Shared across the whole repo. Packable projects (the ones meant to
    ship as NuGet packages/dotnet tools) opt in explicitly with
    <IsPackable>true</IsPackable> in their own csproj - default is false
    here so a plain `dotnet pack` on the solution doesn't try to produce
    a nupkg for every internal runner/test-payload project too.
  -->
  <!--
    Warnings are errors, everywhere, including locally.

    Turned on at a moment when the whole repo genuinely built clean -
    verified per branch, not just at the tip, and across `build`,
    `publish` (the Blazor/wasm host, which the CI solution filter
    excludes) and `pack` (NU5xxx packaging warnings are their own
    family). Switching it on while something was already warning would
    have meant either a scramble or a pile of suppressions; from clean it
    costs nothing and keeps costing nothing.

    Not scoped to ContinuousIntegrationBuild on purpose: a warning that
    only fails in CI is one you find after pushing, having already built
    locally and seen green. The friction of fixing it while the code is
    still in front of you is the point.

    Compiler warnings only. MSBuildTreatWarningsAsErrors is deliberately
    NOT set - it promotes SDK/restore diagnostics that are frequently
    environmental (a workload version, a transitive package's target
    framework) and would fail builds for reasons unrelated to this code.

    To allow one specific warning, add it to WarningsNotAsErrors here
    with a comment saying why, rather than turning this off.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <Authors>Jay Tuley</Authors>
    <Copyright>Copyright 2013-2026 Jay Tuley</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jbtule/AnyUnit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jbtule/AnyUnit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Strong-naming (see Directory.Build.targets for why it's there and not
    here) needs the key file path regardless, so define it once centrally.
  -->
  <PropertyGroup>
    <AnyUnitStrongNameKeyFile>$(MSBuildThisFileDirectory)sn.snk</AnyUnitStrongNameKeyFile>
  </PropertyGroup>

  <!--
    Version comes from git tags (MinVer), not hand-edited per project -
    the old approach had four-plus csproj files independently carrying
    (and drifting on) <Version>1.0.0-alpha</Version>, with newer projects
    simply missing it. MinVerTagPrefix matches the repo's existing tag
    convention (v0.8.0-alpha, v0.9.0-wip).

    MinVerMinimumMajorMinor is the floor for untagged builds, and so is
    where "what is the next release" gets declared - no tag needed, and
    deliberately so: pushing a v* tag is a real release (it triggers
    release-artifacts.yml, which creates a GitHub Release and publishes
    to nuget.org), which is not what bumping the in-development version
    should mean. Without a floor above the latest tag, MinVer
    auto-increments the patch instead: sitting on 1.0 with v1.0.0 cut
    made every untagged build read as 1.0.1-alpha.<height>, i.e. claim
    to be heading for a patch release. 1.1 makes them read as
    1.1.0-alpha.<height> instead. Raise this whenever the next intended
    release changes; the tag itself only gets cut when actually
    releasing.

    (Which is exactly what had gone stale: v1.1.0 was cut while this
    still said 1.1, so untagged master read as 1.1.1-alpha.<height> -
    the same "claiming a patch release" failure mode described above,
    one release later. Then 1.2, for the 1.2 targets; now 1.3, since
    the work since v1.2.2 adds public API - two TestCapabilities
    members, the NUnit classic asserts - and changes a default that
    consumers see, browser-wasm test projects being IsTestProject=false.
    Changes.md's in-development section is the matching declaration and
    moves with this.)
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.3</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!--
    F# projects reference the LOWEST FSharp.Core they actually need,
    not whatever the SDK ships. The SDK's implicit reference is the
    newest (10.1.x with the .NET 10 SDK), and a package built that way
    carries it as a hard floor: the published 1.1.0 of every F# style
    demands FSharp.Core >= 10.1.401, so any consumer pinning 8.x or 9.x
    - a Fable project, anyone on an older SDK - gets NU1605 and cannot
    restore. Found for real, by porting a third-party Expecto suite that
    pins 9.0.300.

    6.0.1 is the conventional floor for a netstandard2.0 F# library and
    everything here builds and runs against it (verified). Applied to
    every fsproj, not just the packable styles, so the test payloads and
    MTP twins exercise that floor in CI too - a floor that is only ever
    compiled against is not a floor that is known to work.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <FSharpCoreImplicitPackageVersion>6.0.1</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
