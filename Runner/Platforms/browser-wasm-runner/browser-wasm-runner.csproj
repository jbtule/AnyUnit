<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CLI tool: `browser-wasm-runner run [-o|-output <file>] [-teamcity] <assemblypaths...>`
    (same flag shape as net10-runner/net48-runner, see Runner/Platforms/shared).
    Drives the generic ../browser-wasm-runner-host WASM app headlessly via
    PuppeteerSharp (pure .NET, no bundled Node.js driver - see
    WasmRunAlone.cs's own comment on why this replaced
    Microsoft.Playwright), serving the caller's test assemblies from
    wherever they actually live on disk (no copying), dynamically loaded
    at runtime by the host - see browser-wasm-runner-host's own comments
    for why no republish per run is needed.

    Named "browser-wasm", not just "wasm": this is specifically the
    Emscripten/browser-wasm target (via Blazor WASM), not WASI's
    `wasi-wasm` - a different, incompatible native target that can't run
    the same native-dependent test assemblies at all (different ABI/
    syscall convention; see browser-wasm-runner-host's own Readme.md for
    the full story). "wasm" alone stopped being unambiguous the moment a
    second wasm target existed.

    PREREQUISITE: publish browser-wasm-runner-host with a plain, standard
    publish (no custom -o) before building/packing THIS project:

      dotnet publish Runner/Platforms/browser-wasm-runner-host -c Release

    This project deliberately does NOT auto-trigger that publish itself
    (an earlier version tried invoking it via an Exec/custom -o inside
    this project's own build/pack targets - dotnet pack's internal
    re-invocations of a PackAsTool project's publish turned out to
    process that nested Exec inconsistently across passes, sometimes
    nesting the host's output an extra directory level and sometimes
    not, in a way that wasn't reliably normalizable from inside this
    project. A separate, plain, standard-location publish - the exact
    form that's been reliable throughout this repo's own manual use of
    it - sidesteps that whole class of problem.) CI runs the publish
    step explicitly before packing (see the publish workflow).

    Below, the standard publish output (bin/Release/net10.0/publish/
    wwwroot) is copied into this project's own $(OutDir)browser-wasm-host/wwwroot
    for local dotnet build/run, and declared as pack content under
    tools/$(TargetFramework)/any/browser-wasm-host/wwwroot/ - the same
    relative layout a packed tool's own assembly ends up in, so
    WasmRunAlone's AppContext.BaseDirectory-relative lookup resolves it
    identically whether run from source or installed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrowserWasmRunner</RootNamespace>
    <!-- Matches ToolCommandName below, so the raw executable is called the
         same thing whether run from source or as the installed tool. -->
    <AssemblyName>anyunit-browser-wasm</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>anyunit-browser-wasm</ToolCommandName>
    <PackageId>AnyUnit.Runner.BrowserWasm</PackageId>
    <Description>Standalone browser-wasm runner for AnyUnit test assemblies, no republish per run (`anyunit-browser-wasm run [-o|-output file] [-teamcity] assembly.dll...`).</Description>

    <BrowserWasmRunnerHostPublishWwwroot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../browser-wasm-runner-host/bin/Release/net10.0/publish/wwwroot/'))</BrowserWasmRunnerHostPublishWwwroot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManyConsole.CommandLineUtils" Version="1.1.8-alpha" />
    <PackageReference Include="PuppeteerSharp" Version="25.10.0" />
  </ItemGroup>

  <Target Name="CheckBrowserWasmRunnerHostPublished" BeforeTargets="Build;_GetPackageFiles">
    <Error Condition="!Exists('$(BrowserWasmRunnerHostPublishWwwroot)index.html')"
           Text="browser-wasm-runner-host hasn't been published. Run: dotnet publish Runner/Platforms/browser-wasm-runner-host -c Release" />
  </Target>

  <Target Name="CopyBrowserWasmRunnerHostToOutput" BeforeTargets="Build" DependsOnTargets="CheckBrowserWasmRunnerHostPublished">
    <ItemGroup>
      <_BrowserWasmHostPublishFiles Include="$(BrowserWasmRunnerHostPublishWwwroot)**" />
    </ItemGroup>
    <Copy SourceFiles="@(_BrowserWasmHostPublishFiles)"
          DestinationFiles="@(_BrowserWasmHostPublishFiles->'$(OutDir)browser-wasm-host\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    PackagePath is a plain destination FOLDER, not a per-file %(...)
    transform: NuGet's pack task auto-preserves each matched file's
    relative path under it for a recursive ** Include. Manual
    %(RecursiveDir)-based transforms (tried first) got contaminated
    somewhere in NuGet's own item processing - confirmed via -v:diag -
    and this simpler, documented form sidesteps that entirely.
  -->
  <ItemGroup>
    <None Include="$(BrowserWasmRunnerHostPublishWwwroot)**" Pack="true" PackagePath="tools\$(TargetFramework)\any\browser-wasm-host\wwwroot" />
  </ItemGroup>

</Project>
