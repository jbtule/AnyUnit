<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CLI tool: `wasm-runner run [-o|-output <file>] [-teamcity] <assemblypaths...>`
    (same flag shape as net10-runner/net48-runner, see Runner/Platforms/shared).
    Drives the generic ../wasm-runner-host WASM app headlessly via
    Playwright, serving the caller's test assemblies from wherever they
    actually live on disk (no copying), dynamically loaded at runtime by
    the host - see wasm-runner-host's own comments for why no
    republish per run is needed.

    NOT YET a packaged dotnet tool: HostWwwroot currently resolves via a
    relative dev path (see Program.cs) rather than bundled tool content.
    Turning this into a real distributable `dotnet tool` package still
    needs the published wasm-runner-host wwwroot embedded as content
    (PackageReference item with Pack="true") - tracked as a follow-up,
    not done here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WasmRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManyConsole.CommandLineUtils" Version="1.1.8-alpha" />
    <PackageReference Include="Microsoft.Playwright" Version="1.55.0" />
  </ItemGroup>

</Project>
