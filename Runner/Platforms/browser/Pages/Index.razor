@page "/"
@using System.Reflection
@using AnyUnit.Run

<h1>AnyUnit browser runner</h1>

@if (_file == null)
{
    <p><em>Running tests...</em></p>
}
else
{
    <table>
        <tbody>
            @foreach (var kv in _file.ResultCount.OrderBy(it => it.Key))
            {
                <tr>
                    <td>@kv.Key</td>
                    <td>@kv.Value</td>
                </tr>
            }
            <tr>
                <td><strong>Total</strong></td>
                <td><strong>@_file.ResultCount.Sum(r => r.Value)</strong></td>
            </tr>
        </tbody>
    </table>

    <pre>@_log</pre>

    @* Machine-readable hooks for a headless host (see Runner/Platforms/browser-host) to
       scrape once the run is finished, without needing any JS interop of its own. *@
    <pre id="anyunit-summary" style="display:none">@_summary</pre>
    <pre id="anyunit-json" style="display:none">@_file.ToListJson()</pre>
    <div id="anyunit-done" style="display:none" data-haserror="@_file.HasError.ToString().ToLowerInvariant()"></div>
}

@code {
    private ResultsFile? _file;
    private readonly System.Text.StringBuilder _logBuilder = new();
    private string _log => _logBuilder.ToString();
    private string _summary => _file == null
        ? string.Empty
        : string.Join("\n",
            _file.ResultCount.OrderBy(kv => kv.Key)
                .Select(kv => $"  {kv.Key,-15}{kv.Value,4}")
                .Append($"{"Total",-17}{_file.ResultCount.Sum(r => r.Value),4}"));

    // Assembly names loaded here are the test payloads referenced by
    // browser-runner.csproj; add more ProjectReferences + names to run them too.
    private static readonly string[] TestAssemblyNames =
    {
        "BasicTests",
        "ConstraintsTests",
        "NunitTests",
        "XunitTests",
    };

    protected override void OnInitialized()
    {
        var assemblies = TestAssemblyNames.Select(Assembly.Load).ToList();

        var runner = Runner.Create("net10-browser", assemblies);
        var file = new ResultsFile();
        runner.RunAll(r =>
        {
            _logBuilder.AppendLine($"{r.Test.Fixture.Assembly.Name}.{r.Test.Fixture.Name}.{r.Test.Name} [{r.Kind}]");
            if (!string.IsNullOrEmpty(r.Output))
            {
                _logBuilder.AppendLine(r.Output);
            }
            file.Add(r);
        });
        _file = file;
    }
}
