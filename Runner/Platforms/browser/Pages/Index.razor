@page "/"
@using AnyUnit.BrowserRunner

<AnyUnitRunnerPage TestAssemblies="TestAssemblies" />

@code {
    // The test payloads this repo dogfoods its own browser runner against.
    // An external consumer would list their own assemblies here instead.
    private static readonly System.Reflection.Assembly[] TestAssemblies =
    {
        typeof(BasicTests.Basic).Assembly,
        typeof(ConstraintsTests.ThrowTest).Assembly,
        typeof(NunitTests.Basic).Assembly,
        typeof(XunitTests.Basic).Assembly,
    };
}
