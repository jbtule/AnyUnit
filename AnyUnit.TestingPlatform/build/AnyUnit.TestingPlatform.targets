<Project>
  <!--
    Same shape as EnableMSTestRunner/EnableNUnitRunner/
    UseMicrosoftTestingPlatformRunner: set EnableAnyUnitRunner=true (per
    TargetFramework, if multi-targeting) and the project becomes a runnable
    MTP executable with no hand-written entry point.

    By default the generated Main tests the project's own entry assembly -
    correct when EnableAnyUnitRunner is set directly on a project that IS
    the test assembly. A satellite runner project that only
    ProjectReferences the real test assembly (e.g. BasicTests.Mtp ->
    BasicTests) instead lists it explicitly:

      <ItemGroup>
        <AnyUnitTestAssembly Include="BasicTests" />
      </ItemGroup>

    (simple assembly name, loaded via Assembly.Load at startup - this is
    what keeps a satellite project from having to hand-write Program.cs
    just to plug in the right assembly).
  -->
  <PropertyGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.0.0" />
  </ItemGroup>

  <Target Name="GenerateAnyUnitRunnerProgram"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <!--
      IntermediateOutputPath isn't fully resolved (TargetFramework-suffixed)
      until Sdk.targets runs, which - since Project Sdk="..." implicitly
      imports Sdk.targets at the very end of the file - is after any
      PropertyGroup textually earlier in this file. Computing it here,
      inside the target body, picks it up at execution time instead, once
      it's actually correct.
    -->
    <PropertyGroup>
      <AnyUnitGeneratedProgramFile>$(IntermediateOutputPath)AnyUnitRunnerProgram.g.cs</AnyUnitGeneratedProgramFile>
      <_AnyUnitAssemblyLoadArgs>@(AnyUnitTestAssembly->'System.Reflection.Assembly.Load(&quot;%(Identity)&quot;)', ', ')</_AnyUnitAssemblyLoadArgs>
      <!-- Only prepend ", " when there's actually something to prepend - the
           common case (no AnyUnitTestAssembly items) leaves
           _AnyUnitAssemblyLoadArgs empty, and RunAsync(args, ) is a syntax
           error, not an empty params list, unlike the previous AddAnyUnit
           TestFramework($(_AnyUnitAssemblyLoadArgs)) call this replaced,
           which never had a leading "args, " to strand. -->
      <_AnyUnitAssemblyLoadArgsWithLeadingComma Condition="'$(_AnyUnitAssemblyLoadArgs)' != ''">, $(_AnyUnitAssemblyLoadArgs)</_AnyUnitAssemblyLoadArgsWithLeadingComma>
    </PropertyGroup>

    <ItemGroup>
      <_AnyUnitProgramLines Include="// Auto-generated by AnyUnit.TestingPlatform.targets. Do not edit." />
      <_AnyUnitProgramLines Include="internal static class AnyUnitRunnerEntryPoint" />
      <_AnyUnitProgramLines Include="{" />
      <_AnyUnitProgramLines Include="    private static System.Threading.Tasks.Task&lt;int&gt; Main(string[] args) =&gt;" />
      <_AnyUnitProgramLines Include="        AnyUnit.TestingPlatform.Runner.RunAsync(args$(_AnyUnitAssemblyLoadArgsWithLeadingComma))%3B" />
      <_AnyUnitProgramLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(AnyUnitGeneratedProgramFile)" Lines="@(_AnyUnitProgramLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(AnyUnitGeneratedProgramFile)" />
      <FileWrites Include="$(AnyUnitGeneratedProgramFile)" />
    </ItemGroup>
  </Target>
</Project>
