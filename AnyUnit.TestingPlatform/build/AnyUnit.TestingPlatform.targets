<Project>
  <!--
    Same shape as EnableMSTestRunner/EnableNUnitRunner/
    UseMicrosoftTestingPlatformRunner: set EnableAnyUnitRunner=true (per
    TargetFramework, if multi-targeting) and the project becomes a runnable
    MTP executable with no hand-written entry point - for a plain .csproj
    or a real .fsproj alike.

    This works by registering AnyUnit.TestingPlatform itself as a
    TestingPlatformBuilderHook (see TestingPlatformBuilderHook.cs's own
    comment) - the same generic extensibility point every other MTP
    extension (TRX, Retry, CrashDump, ...) uses - and letting Microsoft.
    Testing.Platform.MSBuild's own official generator produce the actual
    entry point. An earlier version of this file hand-rolled its own
    generated Main instead (a lone <Target> writing a .g.cs file directly),
    based on the assumption that the official generator only knew how to
    emit C# - that assumption was wrong (verified directly: it emits real,
    correct F# source for an .fsproj too, exactly like Expecto's own MTP
    mode relies on) - so this file no longer needs to invent its own
    codegen at all, C#-only or otherwise.

    By default the test framework tests the project's own entry assembly -
    correct when EnableAnyUnitRunner is set directly on a project that IS
    the test assembly. A satellite runner project that only
    ProjectReferences the real test assembly (e.g. BasicTests.Mtp ->
    BasicTests) instead lists it explicitly:

      <ItemGroup>
        <AnyUnitTestAssembly Include="BasicTests" />
      </ItemGroup>

    (simple assembly name, loaded via Assembly.Load at startup - see
    TestingPlatformBuilderHook.cs for how this reaches it without any
    per-project generated code).
  -->
  <!--
    IsTestingPlatformApplication is set unconditionally, not just when
    EnableAnyUnitRunner is: Microsoft.Testing.Platform's own targets
    default it to true for any project that references it, so without
    this a plain library that merely references AnyUnit.TestingPlatform
    (a satellite runner's test assembly, say) would get an entry point
    generated into it. Same shape as MSTest.TestAdapter.targets'
    IsTestingPlatformApplication=$(EnableMSTestRunner).

    Microsoft.Testing.Platform and Microsoft.Testing.Platform.MSBuild are
    NOT added as PackageReferences here - they're real dependencies of
    the AnyUnit.TestingPlatform package itself (see its csproj for why a
    PackageReference in a package's own targets can never work).
  -->
  <PropertyGroup>
    <IsTestingPlatformApplication>$(EnableAnyUnitRunner)</IsTestingPlatformApplication>
  </PropertyGroup>

  <!--
    An F# project on browser-wasm does not get the generated entry point:
    Microsoft.Testing.Platform.MSBuild's F# template ends in
    Async.RunSynchronously, which on the single-threaded wasm runtime
    blocks the only thread the first time MTP suspends, and F# has no
    async Main for the runtime to await instead. The entry point lives in
    AnyUnit.TestingPlatform.WasmEntry (shipped in this package; see its
    csproj), which the JS harness names with dotnet.withMainAssembly().
    The project itself stays a Library - with no entry point of its own,
    Exe would only earn it FS0988 - and says which assembly holds the
    tests through the AnyUnit.TestAssembly host configuration option
    below, since WasmEntry is then the entry assembly and the
    AssemblyMetadata route reads the entry assembly.
  -->
  <PropertyGroup Condition="'$(EnableAnyUnitRunner)' == 'true' and '$(MSBuildProjectExtension)' == '.fsproj' and ('$(TargetPlatformIdentifier)' == 'browser' or '$(RuntimeIdentifier)' == 'browser-wasm')">
    <_AnyUnitWasmEntry>true</_AnyUnitWasmEntry>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- Sdk.BlazorWebAssembly defaults to Exe; with no entry point of its
         own that is FS0988 ("main module is empty") for an F# project. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableAnyUnitRunner)' == 'true' and '$(_AnyUnitWasmEntry)' != 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    Which assembly holds the tests, as runtime host configuration (it
    lands in runtimeconfig.json / the wasm boot config and reads back as
    AppContext.GetData). The satellite list when there is one, else this
    project. Emitted for every EnableAnyUnitRunner project, not just the
    F#-on-wasm one, so WasmEntry works for any wasm test project and the
    same harness can be used regardless of language.
  -->
  <ItemGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <RuntimeHostConfigurationOption Include="AnyUnit.TestAssembly" Value="@(AnyUnitTestAssembly)" Condition="'@(AnyUnitTestAssembly)' != ''" />
    <RuntimeHostConfigurationOption Include="AnyUnit.TestAssembly" Value="$(AssemblyName)" Condition="'@(AnyUnitTestAssembly)' == ''" />
  </ItemGroup>

  <!--
    Native AOT / PublishTrimmed. AnyUnit discovers fixtures by walking
    Assembly.GetTypes() and reading attributes - nothing references a
    test class statically, so the trimmer would otherwise drop every one
    of them and the published executable would discover zero tests
    (confirmed: that is exactly what PublishAot=true on BasicTests.Mtp
    did before this). Rooting the test assembly keeps all of its types and
    members, which is what reflection-driven discovery needs. Same list
    as AnyUnit.TestAssembly above: the satellite assemblies when there
    are any, else this project. TrimmerRootAssembly is only consulted by
    a trimmed/AOT publish; a plain build ignores it.
  -->
  <ItemGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <TrimmerRootAssembly Include="@(AnyUnitTestAssembly)" Condition="'@(AnyUnitTestAssembly)' != ''" />
    <TrimmerRootAssembly Include="$(AssemblyName)" Condition="'@(AnyUnitTestAssembly)' == ''" />
  </ItemGroup>

  <!--
    F# Async<'T> under Native AOT. The engine starts an Async<'T> a test
    returns via FSharp.Core's generic StartImmediateAsTask<'T> through
    reflection, and ILC only compiles a generic instantiation it can see
    statically - so without this every F# async test fails with "missing
    native code" (see FSharpAsync.rd.xml beside this file for the whole
    story, and which 'T it covers). A target rather than a static item:
    whether FSharp.Core is referenced is only known once references are
    resolved, and this must not fire for a C# project, where the
    directive would name an assembly that is not there. Runs before ILC
    writes its response file, which is where @(RdXmlFile) is read.
  -->
  <Target Name="_AnyUnitFSharpAsyncRdXml" AfterTargets="ResolveAssemblyReferences" BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'$(EnableAnyUnitRunner)' == 'true' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <RdXmlFile Include="$(MSBuildThisFileDirectory)FSharpAsync.rd.xml" Condition="'@(ReferencePath->WithMetadataValue('Filename', 'FSharp.Core'))' != ''" />
    </ItemGroup>
  </Target>

  <!--
    `dotnet run` for a browser-wasm test project. The wasm SDK's own
    RunCommand is WasmAppHost - a dev server plus a browser, which is not
    what running a test project means. Point it at the JS harness under
    bun instead (AnyUnitWasmJsHost=node to use node), the same
    wwwroot/runtests.mjs the CI legs use; MTP's own arguments pass
    through as they would to any MTP exe. MTP's _MTPAddArguments appends
    those to RunArguments right before ComputeRunArguments, so this runs
    before it - a target rather than a plain property because the wasm
    SDK's values are evaluated properties and this has to win regardless
    of import order.

    `dotnet test` is NOT this: in MTP mode it launches the app the same
    way (so it did reach bun) but then talks to it over a named pipe,
    and System.IO.Pipes is unsupported on the wasm runtime - it dies in
    NamedPipeClient before discovery. The IDE test explorers are the
    same story over TCP. IsTestProject=false below keeps a solution-wide
    `dotnet test` from trying; `dotnet run` (or the harness directly, as
    CI does) is how a wasm test project is run.
  -->
  <PropertyGroup Condition="'$(EnableAnyUnitRunner)' == 'true' and ('$(TargetPlatformIdentifier)' == 'browser' or '$(RuntimeIdentifier)' == 'browser-wasm')">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <Target Name="_AnyUnitWasmRunCommand" BeforeTargets="_MTPAddArguments;ComputeRunArguments"
          Condition="'$(EnableAnyUnitRunner)' == 'true' and ('$(TargetPlatformIdentifier)' == 'browser' or '$(RuntimeIdentifier)' == 'browser-wasm')">
    <PropertyGroup>
      <_AnyUnitWasmHarness>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(OutDir), 'wwwroot', 'runtests.mjs'))</_AnyUnitWasmHarness>
      <AnyUnitWasmJsHost Condition="'$(AnyUnitWasmJsHost)' == ''">bun</AnyUnitWasmJsHost>
      <RunCommand>$(AnyUnitWasmJsHost)</RunCommand>
      <RunArguments>&quot;$(_AnyUnitWasmHarness)&quot;</RunArguments>
      <RunWorkingDirectory>$([System.IO.Path]::GetDirectoryName($(_AnyUnitWasmHarness)))</RunWorkingDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AnyUnitWasmHarness)')" Text="No wwwroot/runtests.mjs in the output directory. A browser-wasm test project needs a JS harness to boot under node/bun - see AnyUnit.TestingPlatform's README (browser-wasm, without a browser)." />
  </Target>

  <!--
    !!! IMPORTANT !!!
    DO NOT CHANGE THE GUID - Microsoft.Testing.Platform.MSBuild's own
    entry-point generator uses it to dedupe/order every referenced
    package's own TestingPlatformBuilderHook item (see e.g. Microsoft.
    Testing.Extensions.TrxReport's own build props for the same pattern) -
    a changed GUID would just register a second, duplicate hook.
  -->
  <ItemGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <TestingPlatformBuilderHook Include="239DE213-E40C-425D-B6D8-4C9629F58CA1">
      <DisplayName>AnyUnit.TestingPlatform</DisplayName>
      <TypeFullName>AnyUnit.TestingPlatform.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

  <!--
    Bridges AnyUnitTestAssembly (an ordinary MSBuild item, no meaning to
    Microsoft.Testing.Platform.MSBuild's own generator) into something
    TestingPlatformBuilderHook.AddExtensions can actually read at runtime -
    a real embedded assembly attribute, via the SDK's own AssemblyMetadata
    item support (GenerateAssemblyInfo), not source generation. Works
    identically for a .csproj or an .fsproj, and for more than one
    AnyUnitTestAssembly item (AssemblyMetadataAttribute allows multiple).

    Two steps, not one - confirmed empirically that the obvious one-liner
    (`<AssemblyMetadata Include="AnyUnit.TestAssembly" Value="%(AnyUnitTestAssembly.Identity)" />`)
    does NOT batch the way it looks like it should: with a literal
    (non-transformed) Include, %(AnyUnitTestAssembly.Identity) resolves to
    empty, silently producing an attribute with the right Key and a blank
    Value. Capturing each item's own Identity into a plain custom metadata
    field FIRST, then transforming Include off of @(AnyUnitTestAssembly)
    (which - unlike Identity itself - carries that custom metadata through
    the transform), is the pattern that actually works.
  -->
  <ItemGroup Condition="'$(EnableAnyUnitRunner)' == 'true'">
    <AnyUnitTestAssembly Update="@(AnyUnitTestAssembly)">
      <_AnyUnitTestAssemblyName>%(Identity)</_AnyUnitTestAssemblyName>
    </AnyUnitTestAssembly>
    <AssemblyMetadata Include="@(AnyUnitTestAssembly->'AnyUnit.TestAssembly')">
      <Value>%(_AnyUnitTestAssemblyName)</Value>
    </AssemblyMetadata>
  </ItemGroup>
</Project>
