<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <!--
      This is the MTP adapter library itself, not a test project - but its
      PackageReference to Microsoft.Testing.Platform is enough for editor
      test-discovery (e.g. VS Code's C# extension) to list it as one
      anyway. IsTestProject=false is the standard opt-out flag the MTP/VS
      tooling honors for exactly this.
    -->
    <IsTestProject>false</IsTestProject>
    <!--
      Microsoft.Testing.Platform's own targets default this to true for
      anything that references it - which, now that this project also
      references Microsoft.Testing.Platform.MSBuild (below), would have
      the entry-point generator run against this library. Off here;
      build/AnyUnit.TestingPlatform.targets turns it on in a consumer,
      and only when EnableAnyUnitRunner is.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsPackable>true</IsPackable>
    <Description>Microsoft.Testing.Platform (MTP) adapter for AnyUnit - property-based opt-in via EnableAnyUnitRunner.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.0.0" />
    <!-- Just the capability/property types (ITrxReportCapability,
         TrxFullyQualifiedTypeNameProperty, ...) a test framework
         implements against - the actual TRX file generator is
         Microsoft.Testing.Extensions.TrxReport, a much larger package a
         consuming test project references itself (see
         AnyUnitTrxReportCapability.cs and README.md's own note on this),
         not something this adapter pulls in. Pinned to the same version
         as Microsoft.Testing.Platform above (not bumped - every
         WhoTestsTheTesters/Tests/*.Mtp project pins its own direct
         Microsoft.Testing.Platform 2.0.0 reference too, and NuGet treats
         a transitive bump past that as a downgrade error). -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.0.0" />
    <!--
      The entry-point generator EnableAnyUnitRunner relies on. A real
      package dependency, deliberately - and PrivateAssets="none" so its
      build assets flow through to the consuming test project, which is
      where the generator has to run. The first packaged version tried
      instead to add this as a PackageReference from inside
      build/AnyUnit.TestingPlatform.targets: that works for the in-repo
      .Mtp projects (they import the targets file from source, so the
      item exists at restore time) and cannot work from the nupkg (a
      package's own targets aren't imported until AFTER restore has
      already decided the dependency graph - and under central package
      management it's an NU1008 error on top). Found by porting a real
      third-party test project against the packed 1.2 prerelease:
      EnableAnyUnitRunner built an Exe with an empty Main and no tests.
      MSTest.TestAdapter carries Microsoft.Testing.Platform.MSBuild the
      same way, for the same reason.
    -->
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.0.0" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnyUnit\AnyUnit.csproj" />
    <!--
      Built alongside and shipped in this package's lib folder (below), so
      every consumer references it - inert except on browser-wasm, where
      a JS harness names it as the main assembly. ReferenceOutputAssembly
      false: nothing here calls into it, it only has to be built first.
    -->
    <ProjectReference Include="..\AnyUnit.TestingPlatform.WasmEntry\AnyUnit.TestingPlatform.WasmEntry.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\AnyUnit.TestingPlatform.WasmEntry\bin\$(Configuration)\netstandard2.0\AnyUnit.TestingPlatform.WasmEntry.dll" Pack="true" PackagePath="lib\netstandard2.0" Visible="false" />
  </ItemGroup>

  <!--
    build/*.props,*.targets already carry the NuGet auto-import
    convention name (build\<PackageId>.props/.targets) - just need to
    actually land in the package's build\ folder, which isn't automatic.
  -->
  <ItemGroup>
    <None Include="build\AnyUnit.TestingPlatform.props" Pack="true" PackagePath="build\" />
    <None Include="build\AnyUnit.TestingPlatform.targets" Pack="true" PackagePath="build\" />
    <None Include="build\FSharpAsync.rd.xml" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
