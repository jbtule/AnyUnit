<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Roughly NUnit-compatible attributes and assertions for AnyUnit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\AnyUnit.Constraints\AnyUnit.Constraints.csproj" />
  </ItemGroup>

  <!-- The core's internal trimming-attribute copies, compiled in here too -
       see AnyUnit.Style.Xunit.csproj's identical item for why. -->
  <ItemGroup>
    <Compile Include="..\..\AnyUnit\Util\TrimmerAttributes.cs" Link="Util\TrimmerAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
